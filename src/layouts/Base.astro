---
import '../styles/global.css';
import { locales, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogLocale: string;
}
const { lang, title, description, ogLocale } = Astro.props;
const site = (Astro.site ?? new URL('https://iamabeltran.com')).origin;
const url = (l: string) => `${site}/${l}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="i8h1gNiAlbIWYcj3g0msM_SyEqu4fdnUP7IzdzC7kRg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url(lang)} />

    {locales.map((l) => <link rel="alternate" hreflang={l} href={url(l)} />)}
    <link rel="alternate" hreflang="x-default" href={url('es')} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}/preview.png`} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
